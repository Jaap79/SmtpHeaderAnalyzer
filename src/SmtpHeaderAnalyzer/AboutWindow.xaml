<Window x:Class="SmtpHeaderAnalyzer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Over SMTP Header Analyzer" Width="540" Height="430"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/app-icon.png" Width="42" Height="42" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SMTP HEADER ANALYZER" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="LOKALE FORENSISCHE MAILANALYSE" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="Analyseert RFC 5322-headers, EML- en Outlook MSG-bestanden en reconstrueert routehops, afzenderidentiteiten, authenticatieresultaten, transportbeveiliging en foutafhandeling." TextWrapping="Wrap" LineHeight="20"/>

            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,16,0,12">
                <StackPanel>
                    <TextBlock Text="PRIVACY EN NETWERKGEBRUIK" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Mailanalyse vindt volledig lokaal plaats. Alleen wanneer je zelf op ‘Controleer voor update’ klikt, wordt de publieke GitHub Releases-API benaderd. Headers, bestandsnamen en analyseresultaten worden nooit meegestuurd." TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="UpdateStatusText" Text="Nog niet op updates gecontroleerd." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="UpdateButton" Content="Controleer voor update" Style="{StaticResource PrimaryButton}" Click="CheckForUpdate_Click" Margin="0,0,8,0"/>
                <Button x:Name="ReleaseButton" Content="Open releasepagina" Click="OpenRelease_Click" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="Open source • Windows x64 • .NET 10" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button Content="Sluiten" Click="Close_Click" HorizontalAlignment="Right" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="SmtpHeaderAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmtpHeaderAnalyzer.Converters"
        xmlns:local="clr-namespace:SmtpHeaderAnalyzer"
        xmlns:models="clr-namespace:SmtpHeaderAnalyzer.Models"
        Title="SMTP Header Analyzer" Width="1480" Height="900" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <conv:SeverityBrushConverter x:Key="SeverityBrush"/>
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="34" Height="34" Source="Assets/app-icon.png" Margin="0,0,12,0" SnapsToDevicePixels="True"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SMTP HEADER ANALYZER" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="Offline mailroute- en authenticatieanalyse" Style="{StaticResource MutedText}" FontSize="11"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open bestand" Click="OpenFile_Click" ToolTip="Open EML of MSG (Ctrl+O)" Margin="0,0,8,0"/>
                    <Button Content="JSON / TXT" Click="Export_Click" IsEnabled="{Binding HasAnalysis}" ToolTip="Exporteer alle analysegegevens (Ctrl+S)" Margin="0,0,8,0"/>
                    <Button Content="PDF" Click="ExportPdf_Click" IsEnabled="{Binding HasAnalysis}" ToolTip="Exporteer een opgemaakt PDF-rapport (Ctrl+P)" Margin="0,0,8,0"/>
                    <Button Content="CSV" Click="ExportCsv_Click" IsEnabled="{Binding HasAnalysis}" ToolTip="Exporteer de volledige analyse als CSV (Ctrl+Shift+C)" Margin="0,0,8,0"/>
                    <Button Content="Timeline CSV" Click="ExportTimelineCsv_Click" IsEnabled="{Binding HasAnalysis}" ToolTip="Exporteer alle routehops met UTC-timestamp voor Kali Timeline Tool (Ctrl+Alt+C)" Margin="0,0,8,0"/>
                    <Button Content="Zoeken" Click="Search_Click" IsEnabled="{Binding HasAnalysis}" ToolTip="Zoek in de huidige resultaatweergave (Ctrl+F)" Margin="0,0,8,0"/>
                    <Button x:Name="ThemeButton" Content="Licht thema" Click="Theme_Click" ToolTip="Wissel donker/licht thema" Margin="0,0,8,0"/>
                    <Button Content="Over..." Click="About_Click" ToolTip="Versie- en update-informatie"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,16,16,12">
                        <TextBlock Text="BRON" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Sleep een .eml of .msg hierheen" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="of plak hieronder alleen de mailheaders" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Row="1" Margin="16,0,16,12" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10">
                        <DockPanel>
                            <TextBlock Text="Bron" Style="{StaticResource MutedText}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding SourceLabel}" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </DockPanel>
                    </Border>
                    <TextBox x:Name="HeaderInput" Grid.Row="2" Margin="16,0" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11.5" SpellCheck.IsEnabled="False"
                             ToolTip="Plak RFC 5322-headers. Ctrl+Enter analyseert."/>
                    <Grid Grid.Row="3" Margin="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Geen data verlaat deze pc" Style="{StaticResource MutedText}" FontSize="10" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Wissen" Click="Clear_Click" Margin="8,0"/>
                        <Button Grid.Column="2" Content="Analyseer" Style="{StaticResource PrimaryButton}" Click="Analyze_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Grid Grid.Column="2">
                <Grid x:Name="EmptyState" Visibility="{Binding HasNoAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" MaxWidth="540">
                        <StackPanel>
                            <TextBlock Text="KLAAR VOOR ANALYSE" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="Open een mailbestand of plak de ruwe headers" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,8"/>
                            <TextBlock Text="De tool reconstrueert de route, identiteiten, SPF/DKIM/DMARC, TLS, vertragingen en foutafhandeling. Geen DNS-lookups; resultaten uit de aangeleverde headers blijven bronbewijs." Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20"/>
                            <Button Content="Open EML of MSG" Click="OpenFile_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="VERMOEDELIJKE OORSPRONG" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="{Binding Analysis.ClaimedOrigin}" FontFamily="Cascadia Mono, Consolas" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Analysis.OriginConfidence}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                            <StackPanel><TextBlock Text="ROUTEHOPS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Analysis.Route.Count}" Style="{StaticResource MetricValue}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,8,0" Padding="12">
                            <StackPanel><TextBlock Text="AUTH PASS" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Analysis.PassedAuthCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource GoodBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}" Padding="12">
                            <StackPanel><TextBlock Text="WAARSCHUWINGEN" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Analysis.WarningCount}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/></StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <TabControl x:Name="ResultsTabControl" SelectionChanged="ResultsTabControl_SelectionChanged">
                            <TabItem Header="Overzicht">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="16">
                                        <TextBlock Text="BERICHT" Style="{StaticResource SectionTitle}"/>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                                <TextBlock Text="Onderwerp" Style="{StaticResource MutedText}" Margin="0,2"/><TextBlock Grid.Column="1" Text="{Binding Analysis.Subject}" Margin="0,2"/>
                                                <TextBlock Grid.Row="1" Text="Message-ID" Style="{StaticResource MutedText}" Margin="0,2"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Analysis.MessageId}" Style="{StaticResource MonoText}" Margin="0,2"/>
                                                <TextBlock Grid.Row="2" Text="Date" Style="{StaticResource MutedText}" Margin="0,2"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Analysis.Date}" Style="{StaticResource MonoText}" Margin="0,2"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="ADRESSEN EN ROLLEN" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid x:Name="IdentityGrid" ItemsSource="{Binding Analysis.Identities}" Height="220" Margin="0,0,0,16" LoadingRow="DataGrid_LoadingRow">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="105" DisplayIndex="0"/>
                                                <DataGridTextColumn Header="Naam" Binding="{Binding DisplayName}" Width="180" DisplayIndex="1" ElementStyle="{StaticResource WrappedGridText}"/>
                                                <DataGridTextColumn Header="E-mailadres" Binding="{Binding Address}" Width="*" MinWidth="180" DisplayIndex="2" ElementStyle="{StaticResource WrappedGridText}"/>
                                                <DataGridTextColumn Header="Domein" Binding="{Binding Domain}" Width="220" DisplayIndex="3" ElementStyle="{StaticResource WrappedGridText}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="INTERPRETATIE VAN DE OORSPRONG" Style="{StaticResource SectionTitle}"/>
                                        <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="3,1,1,1" CornerRadius="3" Padding="12">
                                            <TextBlock Text="{Binding Analysis.OriginExplanation}" TextWrapping="Wrap" LineHeight="19"/>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Route">
                                <DataGrid x:Name="RouteGrid" ItemsSource="{Binding Analysis.Route}" Margin="16" LoadingRow="DataGrid_LoadingRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42"/>
                                        <DataGridTextColumn Header="Timestamp (lokaal)" Binding="{Binding TimestampDisplay, Mode=OneWay}" Width="185"/>
                                        <DataGridTextColumn Header="Van" Binding="{Binding From}" Width="*" MinWidth="140" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Naar" Binding="{Binding By}" Width="*" MinWidth="140" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Protocol" Binding="{Binding With}" Width="130" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="IP" Binding="{Binding IpAddress}" Width="140"/>
                                        <DataGridTextColumn Header="Delta" Binding="{Binding DelayDisplay}" Width="85"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Authenticatie">
                                <DataGrid x:Name="AuthenticationGrid" ItemsSource="{Binding Analysis.Authentication}" Margin="16" LoadingRow="DataGrid_LoadingRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Mechanisme" Binding="{Binding Mechanism}" Width="145"/>
                                        <DataGridTextColumn Header="Resultaat" Binding="{Binding Result}" Width="105"/>
                                        <DataGridTextColumn Header="Domein" Binding="{Binding Domain}" Width="190" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Identiteit" Binding="{Binding Identity}" Width="210" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Selector" Binding="{Binding Selector}" Width="135" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="220" ElementStyle="{StaticResource WrappedGridText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Transport">
                                <DataGrid x:Name="TransportGrid" ItemsSource="{Binding Analysis.Transport}" Margin="16" LoadingRow="DataGrid_LoadingRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="48"/>
                                        <DataGridTextColumn Header="Van" Binding="{Binding From}" Width="*" MinWidth="120" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Naar" Binding="{Binding By}" Width="*" MinWidth="120" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="SMTP" Binding="{Binding Protocol}" Width="125"/>
                                        <DataGridTextColumn Header="TLS" Binding="{Binding TlsVersion}" Width="100"/>
                                        <DataGridTextColumn Header="Cipher" Binding="{Binding Cipher}" Width="190" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding EncryptionStatus}" Width="170" ElementStyle="{StaticResource WrappedGridText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Bevindingen">
                                <ListView x:Name="FindingsList" ItemsSource="{Binding Analysis.Findings}" Margin="16"
                                          BorderThickness="0" SelectionMode="Single" VirtualizingPanel.IsVirtualizing="False">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:FindingSeverity.Good}"><Setter Property="Background" Value="{DynamicResource SemanticGoodBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GoodBrush}"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:FindingSeverity.Warning}"><Setter Property="Background" Value="{DynamicResource SemanticWarningBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:FindingSeverity.Critical}"><Setter Property="Background" Value="{DynamicResource SemanticDangerBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="3,1,1,1"/></DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="2,1,1,1"/></Trigger>
                                                <Trigger Property="local:SearchVisual.IsMarked" Value="True"><Setter Property="Background" Value="{DynamicResource SearchMarkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/><Setter Property="BorderThickness" Value="3,1,1,1"/></Trigger>
                                                <Trigger Property="local:SearchVisual.IsCurrent" Value="True"><Setter Property="Background" Value="{DynamicResource SearchCurrentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,1,1,1"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityBrush}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" Foreground="{Binding Severity, Converter={StaticResource SeverityBrush}}" FontWeight="SemiBold" FontSize="10" Margin="12,13"/>
                                                    <StackPanel Grid.Column="2" Margin="0,10,14,10">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Evidence}" Style="{StaticResource MutedText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        <TextBlock Text="{Binding StandardsReference, StringFormat=Referentie: {0}}" Style="{StaticResource MutedText}" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </TabItem>
                            <TabItem Header="Alle headers">
                                <DataGrid x:Name="HeadersGrid" ItemsSource="{Binding Analysis.Headers}" Margin="16" LoadingRow="DataGrid_LoadingRow">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42"/>
                                        <DataGridTextColumn Header="Header" Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource WrappedGridText}"/>
                                        <DataGridTextColumn Header="Waarde" Binding="{Binding DisplayValue}" Width="*" MinWidth="400" ElementStyle="{StaticResource WrappedGridText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="Ongeldige regels">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock Text="Regels die niet als geldige RFC 5322-headervelden konden worden geïnterpreteerd. De bronregel blijft ongewijzigd zichtbaar." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <DataGrid x:Name="InvalidHeaderGrid" Grid.Row="1" ItemsSource="{Binding Analysis.InvalidHeaderLines}" LoadingRow="DataGrid_LoadingRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Regel" Binding="{Binding LineNumber}" Width="70"/>
                                            <DataGridTextColumn Header="Reden" Binding="{Binding Reason}" Width="2*" MinWidth="240" ElementStyle="{StaticResource WrappedGridText}"/>
                                            <DataGridTextColumn Header="Bronregel" Binding="{Binding Raw}" Width="3*" MinWidth="320" ElementStyle="{StaticResource WrappedGridText}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Ctrl+O openen   Ctrl+F zoeken   Ctrl+S exporteren   Ctrl+P PDF   Ctrl+Alt+C timeline" Style="{StaticResource MutedText}" VerticalAlignment="Center" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>

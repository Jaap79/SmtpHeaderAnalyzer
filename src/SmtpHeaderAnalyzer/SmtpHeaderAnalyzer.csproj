<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SmtpHeaderAnalyzer</RootNamespace>
    <AssemblyName>SmtpHeaderAnalyzer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.99</Version>
    <AssemblyVersion>0.99.0.0</AssemblyVersion>
    <FileVersion>0.99.0.0</FileVersion>
    <Product>SMTP Header Analyzer</Product>
    <Company>Open Source Security Tools</Company>
    <Description>Lokale analyse van SMTP-headers, EML- en Outlook MSG-bestanden met een optionele handmatige updatecontrole.</Description>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenMcdf" Version="3.1.4" />
    <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SmtpHeaderAnalyzer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>
</Project>

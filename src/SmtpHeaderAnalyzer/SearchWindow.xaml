<Window x:Class="SmtpHeaderAnalyzer.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zoeken — SMTP Header Analyzer" Width="560" Height="330"
        MinWidth="500" MinHeight="310" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded"
        Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/app-icon.png" Width="36" Height="36" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ZOEKEN IN HUIDIGE WEERGAVE" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ViewText" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="ZOEKTEKST" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Zoekt zonder onderscheid tussen hoofdletters en kleine letters"/>
            <TextBlock x:Name="ResultText" Text="Vul een zoekterm in." Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,10,0,14"/>
            <WrapPanel>
                <Button x:Name="PreviousButton" Content="Vorige" Click="Previous_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="NextButton" Content="Volgende" Style="{StaticResource PrimaryButton}" Click="Next_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="MarkButton" Content="Markeer regel" Click="Mark_Click" IsEnabled="False" Margin="0,0,8,8"/>
                <Button x:Name="ClearMarksButton" Content="Wis markeringen" Click="ClearMarks_Click" IsEnabled="False" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="Enter/F3: volgende  •  Shift+Enter/Shift+F3: vorige  •  Esc: sluiten"
                       Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock Text="Markeringen gelden alleen voor deze geopende analyse" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Button Content="Sluiten" Click="Close_Click" HorizontalAlignment="Right" IsCancel="True"/>
            </Grid>
        </Border>
    </Grid>
</Window>
